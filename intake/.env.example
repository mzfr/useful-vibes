INTAKE_SECRET_KEY=change-me-in-prod
INTAKE_DB_PATH=./data/db.sqlite3
INTAKE_INITIAL_PASSWORD=changeme
INTAKE_DEBUG=1
# Comma-separated. "*" only works in dev; prod refuses it.
INTAKE_ALLOWED_HOSTS=localhost,127.0.0.1

TMDB_API_KEY=
# Optional fallback; the public history domain is editable in Intake settings.
INTAKE_HISTORY_PUBLIC_URL=
# No Trakt keys needed — import the data export ZIP from trakt.tv/settings/data.
